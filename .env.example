# AITAM Disaster Response AI - Environment Configuration Example

APP_NAME=AITAM Disaster Response AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./campusflow.db
ALLOW_ANONYMOUS_ADMIN=false
AUTOMATIC_AI_WORKFLOW=true
CAMPUS_LOCATION=Tekkali, Srikakulam, Andhra Pradesh, India
CAMPUS_DEFAULT_LAT=18.56517
CAMPUS_DEFAULT_LNG=84.19587

# Required for deployment; generate a unique secret and keep it out of source control.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=86400

# Centralized LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional backend-only multimodal image evidence. Without a matching key the
# API returns IMAGE_ANALYSIS_UNAVAILABLE and never invents findings.
VISION_PROVIDER=none
VISION_MODEL=
VISION_API_URL=https://api.openai.com/v1/chat/completions
VISION_TIMEOUT_SECONDS=45
VISION_RETRIES=1

# Local development storage boundary for uploaded evidence. Production may
# replace this with a configured object-storage implementation.
EVIDENCE_STORAGE_PROVIDER=local
EVIDENCE_STORAGE_DIR=backend/storage/evidence
EVIDENCE_MAX_BYTES=10485760

# Weather/risk configuration (backend only). Use demo for offline development;
# use open_meteo for the public Open-Meteo current-weather adapter.
WEATHER_PROVIDER=open_meteo
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_TIMEOUT_SECONDS=5
WEATHER_RETRIES=2
WEATHER_RETRY_BACKOFF_SECONDS=0.25
WEATHER_STALE_AFTER_MINUTES=30
ALLOW_DETERMINISTIC_FALLBACK=true
ENVIRONMENT_PROVIDER=open_meteo
RISK_ALERT_COOLDOWN_MINUTES=30
RISK_THRESHOLDS_JSON={"low":0,"medium":25,"high":50,"critical":75}
RISK_WEIGHTS_JSON={}

# USGS earthquake event feed. Events are thresholded and geographically
# filtered before any optional assessment enters the disaster workflow.
EARTHQUAKE_PROVIDER=usgs
EARTHQUAKE_API_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
EARTHQUAKE_TIMEOUT_SECONDS=8
EARTHQUAKE_RETRIES=2
EARTHQUAKE_RETRY_BACKOFF_SECONDS=0.25
EARTHQUAKE_MIN_MAGNITUDE=4.5
EARTHQUAKE_RADIUS_KM=500
EARTHQUAKE_LOOKBACK_HOURS=24
EARTHQUAKE_STALE_AFTER_MINUTES=120

# Authoritative India severe-weather warnings; community photos never create a warning.
SEVERE_WEATHER_PROVIDER=imd_cap
SEVERE_WEATHER_API_URL=https://cap-sources.s3.amazonaws.com/in-imd-en/rss.xml
SEVERE_WEATHER_TIMEOUT_SECONDS=8
SEVERE_WEATHER_RETRIES=2
SEVERE_WEATHER_RETRY_BACKOFF_SECONDS=0.25
SEVERE_WEATHER_STALE_AFTER_MINUTES=120
SEVERE_WEATHER_RADIUS_KM=150

# Best-effort reverse geocoding for user-selected coordinates.
GEOCODING_PROVIDER=nominatim
GEOCODING_API_URL=https://nominatim.openstreetmap.org/reverse
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_RETRIES=1
GEOCODING_RETRY_BACKOFF_SECONDS=0.25

# Persistent personal-assistant memory (Mem0 Platform; backend only)
MEM0_ENABLED=true
MEM0_API_KEY=
MEM0_ORGANIZATION_ID=

# Map & Routing Providers
MAP_PROVIDER=esri_satellite
MAP_API_KEY=
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
ROUTING_BASE_URL=http://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=5
ROUTING_RETRIES=2
ROUTING_RETRY_BACKOFF_SECONDS=0.25

# Optional normalized HTTP/IoT sensor gateway. Hardware is not claimed unless
# this endpoint is configured and returns validated observations.
SENSOR_PROVIDER=demo
SENSOR_API_URL=
SENSOR_API_KEY=
SENSOR_TIMEOUT_SECONDS=5
SENSOR_RETRIES=2
SENSOR_RETRY_BACKOFF_SECONDS=0.25

# Out-of-scope delivery channels intentionally have no production
# configuration here. Operational alerts use the authenticated in-app
# WebSocket and durable notification history only.

# Disaster Response Dispatch API
DISPATCH_PROVIDER=
DISPATCH_API_URL=
DISPATCH_API_TOKEN=

# Telemetry Endpoint Auth
GPS_TELEMETRY_SECRET=

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Automation / Webhooks
N8N_WEBHOOK_URL=

