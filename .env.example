# CAMPUSFLOW AI - Environment Configuration Example

APP_NAME=CampusFlow AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./campusflow.db

# Centralized LLM Configuration
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Persistent personal-assistant memory (Mem0 Platform; backend only)
MEM0_ENABLED=true
MEM0_API_KEY=
MEM0_ORGANIZATION_ID=

# Map & Routing Providers
MAP_PROVIDER=esri_satellite
MAP_API_KEY=
ROUTING_PROVIDER=osrm
ROUTING_API_KEY=
ROUTING_BASE_URL=http://router.project-osrm.org

# SMS Provider Configuration
SMS_PROVIDER=
SMS_ACCOUNT_ID=
# Use either SMS_AUTH_TOKEN, or the API-key pair below (preferred when both exist).
SMS_AUTH_TOKEN=
SMS_API_KEY_SID=
SMS_API_KEY_SECRET=
SMS_FROM_NUMBER=
TEST_PHONE_NUMBER=

# Push Notification Configuration
PUSH_PROVIDER=
PUSH_CREDENTIALS=
TEST_DEVICE_TOKEN=

# SMTP Email Configuration
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=emergency-alert@vignan.ac.in
TEST_EMAIL_ADDRESS=

# Voice Call & Telephony Configuration
VOICE_PROVIDER=
VOICE_ACCOUNT_ID=
VOICE_AUTH_TOKEN=
VOICE_FROM_NUMBER=
TEST_VOICE_NUMBER=

# Campus Emergency Dispatch API
DISPATCH_PROVIDER=
DISPATCH_API_URL=
DISPATCH_API_TOKEN=

# Telemetry Endpoint Auth
GPS_TELEMETRY_SECRET=campusflow-secret-telemetry-key

# Frontend Configuration
FRONTEND_URL=http://localhost:5173

# Automation / Webhooks
N8N_WEBHOOK_URL=

